rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin')
      );
    }
    
    function isSales() {
      return isAuthenticated() && (
        request.auth.token.role == 'sales' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (getUserData().role == 'sales' || getUserData().role == 'admin'))
      );
    }

    // 1. Quizzes Collection: Anyone can read, only Admin can write
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Student Submissions Collection: Anyone can submit, Admin & Sales can read/delete
    match /student_submissions/{submissionId} {
      allow create: if true;
      allow read, delete: if isSales() || isAdmin();
      allow update: if isAdmin();
    }

    // 3. Registered Students Roster Collection: Public create & read for login check, Admin & Sales full access
    match /registered_students/{studentId} {
      allow read, create: if true;
      allow update, delete: if isSales() || isAdmin();
    }

    // 4. Inquiries & Fee Estimates Collection: Public create, Admin & Sales read/update
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isSales() || isAdmin();
    }

    // 5. Users Collection: Users read own data, Admin read/write all
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSales() || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
  }
}
